---
import GitHub from "../assets/Github.astro"
import AstroIcon from "../assets/Astro.astro"
import Tailwind from "../assets/Tailwind.astro"
import Supabase from "../assets/Supabase.astro"
import Link from "../assets/Link.astro"
import LinkButton from "./LinkButton.astro"

const TAGS = {
  ASTRO: {
    name: "Astro",
    class: "bg-[#FF5D01] text-white",
    icon: AstroIcon,
  },
  TAILWIND: {
    name: "Tailwind CSS",
    class: "bg-[#003159] text-white",
    icon: Tailwind,
  },
  SUPABASE: {
    name: "Supabase",
    class: "bg-[#3ECF8E] text-black",
    icon: Supabase,
  },
}
const PROJECTS = [
  {
    title: "ISO — Marca de streetwear inspirada en baloncesto",
    description:
      "Diseñé y desarrollé la web de ISO, una marca de ropa streetwear con eventos de baloncesto 1v1 como motor de lanzamiento. Construí carrito de compra con checkout por WhatsApp, una lista de espera prioritaria conectada a Supabase, y un panel de validación de entradas en tiempo real con lectura de códigos QR para el staff del evento — todo desplegado en producción y usado en un torneo real.",
    link: "https://isowear.es",
    github: "https://github.com/raafa12/iso-web",
    image: "/images/iso-hero.png",
    tags: [TAGS.ASTRO, TAGS.SUPABASE, TAGS.TAILWIND],
  },
  {
    title: "Aro 3 - Website",
    description:
     "One page de un proyecto residencial para una promotora local en Santoña. Creado desde cero con Astro y Tailwind CSS.",
    link: "https://residencialaro3.com/",
    github: "https://github.com/raafa12/ResidencialAro3",
    image: "/images/aro3.png",
    tags: [TAGS.ASTRO, TAGS.TAILWIND],
  },
  {
    title: "Club Baloncesto Calasanz - Website",
    description:
      "Proyecto para digitalizar la sección de baloncesto del club deportivo Calasanz Santander. Creado desde cero con Astro y Tailwind CSS.",
    link: "https://baloncestocalasanz.netlify.app/",
    github: "https://github.com/raafa12/Baloncesto-Calasanz",
    image: "/images/WebCala.png",
    tags: [TAGS.ASTRO, TAGS.TAILWIND],
  },
]
---

<div class="grid grid-cols-1 gap-8 sm:gap-12">
  {
    PROJECTS.map(({ image, title, description, tags, link, github }) => (
      <article class="group relative overflow-hidden rounded-2xl bg-white/5 backdrop-blur-xl border border-white/10 shadow-xl transition-all duration-500 hover:-translate-y-1 hover:shadow-2xl hover:bg-white/10 dark:bg-white/5 dark:border-white/10">
        <div class="absolute inset-0 bg-gradient-to-br from-white/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
        <div class="relative flex flex-col space-y-6 p-6 sm:space-y-8 sm:p-8 md:flex-row md:space-x-8 md:space-y-0">
          {/* Project Image - Full width on mobile, half on desktop */}
          <div class="md:w-1/2">
            <a 
              href={link}
              target="_blank"
              rel="noopener noreferrer"
              class="relative block overflow-hidden rounded-xl border border-white/10 shadow-lg transition-all duration-300 hover:scale-[1.02] hover:shadow-xl"
              aria-label={`View ${title} project`}
            >
              <div class="relative aspect-video overflow-hidden">
                <img 
                  alt={title}
                  class="h-full w-full object-cover object-top transition-transform duration-700 group-hover:scale-105"
                  loading="lazy"
                  src={image}
                  width={600}
                  height={400}
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-black/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                <div class="absolute inset-0 bg-gradient-to-b from-black/10 to-transparent opacity-70"></div>
              </div>
            </a>
          </div>

          {/* Project Content - Full width on mobile, half on desktop */}
          <div class="relative flex flex-1 flex-col md:py-1">
            {/* Title */}
            <h3 class="mb-3 text-xl font-bold text-white/95 dark:text-green-100 sm:text-2xl md:mb-4">
              <span class="relative z-10 bg-gradient-to-r from-white to-white/80 bg-clip-text text-transparent">
                {title}
              </span>
            </h3>
            
            {/* Tags */}
            <ul class="mb-4 flex flex-wrap gap-2">
              {tags.map((tag) => (
                <li class="group/tag">
                  <span class={`inline-flex items-center gap-1.5 rounded-full border border-white/10 bg-white/5 px-3 py-1.5 text-xs font-medium text-white/90 backdrop-blur-sm transition-all duration-300 ${tag.class} hover:bg-white/15 hover:border-white/20 hover:shadow-md`}>
                    <tag.icon class="size-3.5" />
                    <span class="relative z-10">{tag.name}</span>
                    <span class="absolute inset-0 rounded-full bg-white/5 opacity-0 group-hover/tag:opacity-100 transition-opacity duration-300"></span>
                  </span>
                </li>
              ))}
            </ul>

            {/* Description */}
            <div class="mb-6 text-sm leading-relaxed text-white/80 dark:text-gray-300 sm:text-base">
              <p class="relative z-10">{description}</p>
            </div>

            {/* Buttons - Stack on mobile, row on larger screens */}
            <div class="mt-auto flex flex-col space-y-3 sm:flex-row sm:space-x-3 sm:space-y-0">
              {link && (
                <a 
                  href={link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group/btn relative flex w-full items-center justify-center rounded-lg border border-white/20 bg-white/10 px-5 py-2.5 text-sm font-medium text-white/90 backdrop-blur-sm transition-all duration-300 hover:bg-white/20 hover:shadow-lg hover:shadow-white/5 sm:w-auto"
                >
                  <Link class="size-4 transition-transform duration-300 group-hover/btn:scale-110" />
                  <span class="ml-2">Ver Proyecto</span>
                  <span class="absolute inset-0 rounded-lg bg-gradient-to-r from-white/10 to-transparent opacity-0 transition-opacity duration-300 group-hover/btn:opacity-100"></span>
                </a>
              )}
              {github && (
                <a 
                  href={github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group/btn relative flex w-full items-center justify-center rounded-lg border border-white/10 bg-white/5 px-5 py-2.5 text-sm font-medium text-white/90 backdrop-blur-sm transition-all duration-300 hover:bg-white/10 hover:shadow-lg hover:shadow-white/5 sm:w-auto"
                >
                  <GitHub class="size-4 transition-transform duration-300 group-hover/btn:scale-110" />
                  <span class="ml-2">Código Fuente</span>
                  <span class="absolute inset-0 rounded-lg bg-gradient-to-r from-white/5 to-transparent opacity-0 transition-opacity duration-300 group-hover/btn:opacity-100"></span>
                </a>
              )}
            </div>
          </div>
        </div>
      </article>
    ))
  }
</div>


