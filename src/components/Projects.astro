---
import GitHub from "../assets/Github.astro"
import AstroIcon from "../assets/Astro.astro"
import Tailwind from "../assets/Tailwind.astro"
import Supabase from "../assets/Supabase.astro"
import ReactIcon from "../assets/React.astro"
import Link from "../assets/Link.astro"
import LinkButton from "./LinkButton.astro"

const TAGS = {
  ASTRO: {
    name: "Astro",
    class: "bg-[#FF5D01] text-white",
    icon: AstroIcon,
  },
  TAILWIND: {
    name: "Tailwind CSS",
    class: "bg-[#003159] text-white",
    icon: Tailwind,
  },
  SUPABASE: {
    name: "Supabase",
    class: "bg-[#3ECF8E] text-black",
    icon: Supabase,
  },
  REACT: {
    name: "React",
    class: "bg-[#20232A] text-[#61DAFB]",
    icon: ReactIcon,
  },
}
const PROJECTS = [
  {
    title: "ISO — Marca de streetwear inspirada en baloncesto",
    description:
      "Web de una marca de streetwear con torneos de baloncesto 1v1 como motor de lanzamiento. Carrito con checkout por WhatsApp y catálogo de productos migrados a React, con estado gestionado en cliente y datos servidos en tiempo real desde Supabase. El primer torneo (agosto 2026) reunió a más de 300 personas en directo.",
    link: "https://isowear.es",
    github: "https://github.com/raafa12/iso-web",
    image: "/images/iso-torneo.jpg",
    imagePosition: "object-[center_62%]",
    tags: [TAGS.REACT, TAGS.ASTRO, TAGS.SUPABASE, TAGS.TAILWIND],
  },
  {
    title: "Aro 3 - Website",
    description:
     "One page para un proyecto residencial de una promotora en Santoña, creada desde cero con Astro y Tailwind CSS.",
    link: "https://residencialaro3.com/",
    github: "https://github.com/raafa12/ResidencialAro3",
    image: "/images/aro3.png",
    tags: [TAGS.ASTRO, TAGS.TAILWIND],
  },
  {
    title: "Club Baloncesto Calasanz - Website",
    description:
      "Digitalización de la sección de baloncesto de un club deportivo, creada desde cero con Astro y Tailwind CSS.",
    link: "https://baloncestocalasanz.netlify.app/",
    github: "https://github.com/raafa12/Baloncesto-Calasanz",
    image: "/images/WebCala.png",
    tags: [TAGS.ASTRO, TAGS.TAILWIND],
  },
]
---

<div class="grid grid-cols-1 gap-8 sm:gap-12">
  {
    PROJECTS.map(({ image, title, description, tags, link, github, imagePosition }) => (
      <article class="group relative overflow-hidden rounded-2xl bg-slate-900/[0.03] backdrop-blur-xl border border-slate-900/10 shadow-lg transition-all duration-500 hover:-translate-y-1 hover:shadow-xl hover:bg-slate-900/[0.05] dark:bg-white/5 dark:border-white/10 dark:hover:bg-white/10 dark:shadow-xl dark:hover:shadow-2xl">
        <div class="absolute inset-0 bg-gradient-to-br from-white/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500 hidden dark:block"></div>
        <div class="relative flex flex-col space-y-6 p-6 sm:space-y-8 sm:p-8 md:flex-row md:space-x-8 md:space-y-0">
          {/* Project Image - Full width on mobile, half on desktop */}
          <div class="md:w-1/2">
            <a 
              href={link}
              target="_blank"
              rel="noopener noreferrer"
              class="relative block overflow-hidden rounded-xl border border-slate-900/10 dark:border-white/10 shadow-lg transition-all duration-300 hover:scale-[1.02] hover:shadow-xl"
              aria-label={`View ${title} project`}
            >
              <div class="relative aspect-video overflow-hidden">
                <img 
                  alt={title}
                  class={`h-full w-full object-cover ${imagePosition ?? "object-top"} transition-transform duration-700 group-hover:scale-105`}
                  loading="lazy"
                  src={image}
                  width={600}
                  height={400}
                />
                <div class="absolute inset-0 bg-gradient-to-t from-black/40 via-black/10 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
                <div class="absolute inset-0 bg-gradient-to-b from-black/10 to-transparent opacity-70"></div>
              </div>
            </a>
          </div>

          {/* Project Content - Full width on mobile, half on desktop */}
          <div class="relative flex flex-1 flex-col md:py-1">
            {/* Title */}
            <h3 class="mb-3 text-xl font-bold text-[#1E2432] dark:text-green-100 sm:text-2xl md:mb-4">
              <span class="relative z-10">
                {title}
              </span>
            </h3>
            
            {/* Tags */}
            <ul class="mb-4 flex flex-wrap gap-2">
              {tags.map((tag) => (
                <li class="group/tag">
                  <span class={`inline-flex items-center gap-1.5 rounded-full border border-slate-900/10 dark:border-white/10 px-3 py-1.5 text-xs font-medium backdrop-blur-sm transition-all duration-300 ${tag.class} hover:shadow-md`}>
                    <tag.icon class="size-3.5" />
                    <span class="relative z-10">{tag.name}</span>
                  </span>
                </li>
              ))}
            </ul>

            {/* Description */}
            <div class="mb-6 text-sm leading-relaxed text-[#4B5568] dark:text-gray-300 sm:text-base">
              <p class="relative z-10">{description}</p>
            </div>

            {/* Buttons - Stack on mobile, row on larger screens */}
            <div class="mt-auto flex flex-col space-y-3 sm:flex-row sm:space-x-3 sm:space-y-0">
              {link && (
                <a 
                  href={link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group/btn relative flex w-full items-center justify-center rounded-lg border border-slate-900/15 bg-slate-900/[0.04] px-5 py-2.5 text-sm font-medium text-[#1E2432] backdrop-blur-sm transition-all duration-300 hover:bg-slate-900/[0.08] hover:shadow-md sm:w-auto dark:border-white/20 dark:bg-white/10 dark:text-white/90 dark:hover:bg-white/20 dark:hover:shadow-lg dark:hover:shadow-white/5"
                >
                  <Link class="size-4 transition-transform duration-300 group-hover/btn:scale-110" />
                  <span class="ml-2">Ver Proyecto</span>
                </a>
              )}
              {github && (
                <a 
                  href={github}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="group/btn relative flex w-full items-center justify-center rounded-lg border border-slate-900/10 bg-transparent px-5 py-2.5 text-sm font-medium text-[#1E2432] backdrop-blur-sm transition-all duration-300 hover:bg-slate-900/[0.04] hover:shadow-md sm:w-auto dark:border-white/10 dark:bg-white/5 dark:text-white/90 dark:hover:bg-white/10 dark:hover:shadow-lg dark:hover:shadow-white/5"
                >
                  <GitHub class="size-4 transition-transform duration-300 group-hover/btn:scale-110" />
                  <span class="ml-2">Código Fuente</span>
                </a>
              )}
            </div>
          </div>
        </div>
      </article>
    ))
  }
</div>


