---
import SunIcon from "../assets/Sun.astro"
import MoonIcon from "../assets/Moon.astro"
---

<button 
  id="theme-toggle"
  class="appearance-none border-none flex items-center justify-center w-9 h-9 rounded-full transition-all duration-300 relative overflow-hidden
         bg-white/10 dark:bg-white/5
         hover:bg-white/20 dark:hover:bg-white/10
         hover:scale-110 hover:-translate-y-0.5
         focus:outline-none focus:ring-2 focus:ring-amber-400/50 dark:focus:ring-green-400/50 focus:ring-offset-2 focus:ring-offset-transparent
         border border-white/20 dark:border-white/10
         hover:border-white/30 dark:hover:border-white/20
         shadow-lg hover:shadow-xl
         active:scale-95
         cursor-pointer"
  aria-label="Cambiar tema"
>
  <!-- Background gradient on hover -->
  <div class="absolute inset-0 bg-gradient-to-r from-green-400/10 via-transparent to-green-400/10 opacity-0 hover:opacity-100 transition-opacity duration-300 rounded-full"></div>
  
  <!-- Subtle glow -->
  <div class="absolute inset-0 rounded-full bg-gradient-to-r from-green-400/20 via-transparent to-green-400/20 blur-sm opacity-0 hover:opacity-50 transition-opacity duration-300"></div>
  
  <!-- Icons container -->
  <div class="relative z-10 flex items-center justify-center">
    <SunIcon id="light-icon" class="size-5 text-gray-700 dark:hidden" />
    <MoonIcon id="dark-icon" class="size-5 hidden dark:block text-gray-300" />
  </div>
  
  <!-- Shine effect -->
  <div class="absolute inset-0 opacity-0 hover:opacity-100 transition-opacity duration-500 rounded-full">
    <div class="absolute top-1 left-1/4 w-1/2 h-px bg-gradient-to-r from-transparent via-white/30 to-transparent"></div>
  </div>
</button>

<script is:inline>
  // Set default theme to dark if not set
  if (localStorage.theme === undefined) {
    localStorage.theme = 'dark';
  }

  // Check for saved user preference, if any, on load
  const savedTheme = localStorage.theme || 'dark';
  
  // Apply the saved theme
  if (savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
    document.documentElement.classList.add('dark');
  } else {
    document.documentElement.classList.remove('dark');
  }

  // Toggle theme on button click
  document.getElementById('theme-toggle').addEventListener('click', () => {
    // Toggle the theme
    if (document.documentElement.classList.contains('dark')) {
      document.documentElement.classList.remove('dark');
      localStorage.theme = 'light';
    } else {
      document.documentElement.classList.add('dark');
      localStorage.theme = 'dark';
    }
  });
</script>