---
import SunIcon from "../assets/Sun.astro"
import MoonIcon from "../assets/Moon.astro"
---

<button 
  id="theme-toggle"
  class="appearance-none border-none flex items-center justify-center w-9 h-9 rounded-full transition-all duration-300 relative overflow-hidden
         bg-white/10 dark:bg-white/5
         hover:bg-white/20 dark:hover:bg-white/10
         hover:scale-110 hover:-translate-y-0.5
         focus:outline-none focus:ring-2 focus:ring-green-400/50 focus:ring-offset-2 focus:ring-offset-transparent
         border border-white/20 dark:border-white/10
         hover:border-white/30 dark:hover:border-white/20
         shadow-lg hover:shadow-xl
         active:scale-95
         cursor-pointer"
  aria-label="Cambiar tema"
>
  <!-- Background gradient on hover -->
  <div class="absolute inset-0 bg-gradient-to-r from-green-400/10 via-transparent to-green-400/10 opacity-0 hover:opacity-100 transition-opacity duration-300 rounded-full"></div>
  
  <!-- Subtle glow -->
  <div class="absolute inset-0 rounded-full bg-gradient-to-r from-green-400/20 via-transparent to-green-400/20 blur-sm opacity-0 hover:opacity-50 transition-opacity duration-300"></div>
  
  <!-- Icons container -->
  <div class="relative z-10 flex items-center justify-center">
    <SunIcon id="light-icon" class="size-5 text-amber-600 dark:hidden" />
    <MoonIcon id="dark-icon" class="size-5 hidden dark:block text-gray-300" />
  </div>
  
  <!-- Shine effect -->
  <div class="absolute inset-0 opacity-0 hover:opacity-100 transition-opacity duration-500 rounded-full">
    <div class="absolute top-1 left-1/4 w-1/2 h-px bg-gradient-to-r from-transparent via-white/30 to-transparent"></div>
  </div>
</button>

<!-- Sun Rays Effect -->
<div class="sun-rays"></div>

<!-- Solar Flares -->
<div class="solar-flare solar-flare-1"></div>
<div class="solar-flare solar-flare-2"></div>

<!-- Sun Particles Container -->
<div id="sun-particles"></div>

<script is:inline>
  // Set default theme to dark if not set
  if (localStorage.theme === undefined) {
    localStorage.theme = 'dark';
  }

  // Check for saved user preference, if any, on load
  const savedTheme = localStorage.theme || 'dark';
  
  // Apply the saved theme
  if (savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
    document.documentElement.classList.add('dark');
  } else {
    document.documentElement.classList.remove('dark');
  }

  // Create sun particles
  function createSunParticles() {
    const container = document.getElementById('sun-particles');
    if (!container) return;
    
    // Clear existing particles
    container.innerHTML = '';
    
    // Only create particles for light theme
    if (!document.documentElement.classList.contains('dark')) {
      for (let i = 0; i < 20; i++) {
        const particle = document.createElement('div');
        particle.className = 'sun-particle';
        
        // Random size between 2px and 6px
        const size = Math.random() * 4 + 2;
        
        // Random position
        const posX = Math.random() * 100;
        const posY = Math.random() * 100;
        
        // Random animation duration between 10s and 20s
        const duration = Math.random() * 10 + 10;
        
        // Random delay
        const delay = Math.random() * -20;
        
        // Apply styles
        particle.style.width = `${size}px`;
        particle.style.height = `${size}px`;
        particle.style.left = `${posX}%`;
        particle.style.top = `${posY}%`;
        particle.style.animationDuration = `${duration}s`;
        particle.style.animationDelay = `${delay}s`;
        
        // Random color from yellow to orange
        const hue = Math.floor(Math.random() * 30) + 20; // 20-50 (yellow to orange)
        particle.style.background = `hsl(${hue}, 100%, 70%)`;
        
        container.appendChild(particle);
      }
    }
  }

  // Toggle theme on button click
  document.getElementById('theme-toggle').addEventListener('click', () => {
    // Toggle the theme
    if (document.documentElement.classList.contains('dark')) {
      document.documentElement.classList.remove('dark');
      localStorage.theme = 'light';
    } else {
      document.documentElement.classList.add('dark');
      localStorage.theme = 'dark';
    }
    
    // Recreate particles when switching to light theme
    if (!document.documentElement.classList.contains('dark')) {
      createSunParticles();
    }
  });

  // Initial creation of particles
  createSunParticles();
  
  // Recreate particles on window resize
  let resizeTimer;
  window.addEventListener('resize', () => {
    clearTimeout(resizeTimer);
    resizeTimer = setTimeout(() => {
      createSunParticles();
    }, 250);
  });
</script>