---

<button
  id="lang-toggle"
  type="button"
  class="relative appearance-none bg-transparent border-none p-0 m-0 h-9 flex items-center justify-center
         text-xs font-bold tracking-wide
         text-gray-700 dark:text-gray-300
         hover:text-[#B45309] dark:hover:text-green-400
         transition-colors duration-200
         cursor-pointer select-none"
  aria-label="Cambiar idioma / Switch language"
>
  <span id="lang-label">EN</span>
</button>

<script is:inline>
  (function () {
    function applyLang(lang) {
      document.documentElement.lang = lang;

      document.querySelectorAll(".i18n-es").forEach((el) => {
        el.hidden = lang !== "es";
      });
      document.querySelectorAll(".i18n-en").forEach((el) => {
        el.hidden = lang !== "en";
      });

      const label = document.getElementById("lang-label");
      if (label) label.textContent = lang === "es" ? "EN" : "ES";
    }

    function init() {
      if (localStorage.lang === undefined) {
        localStorage.lang = "es";
      }
      applyLang(localStorage.lang);

      const toggle = document.getElementById("lang-toggle");
      if (toggle && !toggle.dataset.bound) {
        toggle.dataset.bound = "true";
        toggle.addEventListener("click", () => {
          const next = localStorage.lang === "es" ? "en" : "es";
          localStorage.lang = next;
          applyLang(next);
        });
      }
    }

    init();
    document.addEventListener("astro:page-load", init);
  })();
</script>
