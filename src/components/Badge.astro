---
// Badge mejorado con estilo glassmorphism espacial
---

<a href="https://www.linkedin.com/in/rafael-basanta-gonz%C3%A1lez-755b092a6/" target="_blank" rel="noopener noreferrer" class="group">
  <div class="flex items-center justify-center">
    <span class="relative inline-flex overflow-hidden rounded-full p-[1px] shadow-lg cursor-pointer transition-all duration-500 hover:shadow-xl hover:scale-105">
      <!-- Animated border -->
      <span class="absolute inset-[-1000%] animate-[spin_4s_linear_infinite] bg-[conic-gradient(from_180deg_at_50%_50%,rgba(255,195,0,0.8)_0%,rgba(255,88,51,0.6)_25%,rgba(255,195,0,0.4)_50%,rgba(199,0,56,0.6)_75%,rgba(255,195,0,0.8)_100%)] dark:bg-[conic-gradient(from_180deg_at_50%_50%,rgba(81,228,184,0.8)_0%,rgba(120,180,255,0.6)_25%,rgba(81,228,184,0.4)_50%,rgba(33,85,78,0.6)_75%,rgba(81,228,184,0.8)_100%)] group-hover:animate-[spin_2s_linear_infinite]"></span>
      
      <!-- Badge content -->
      <div class="inline-flex items-center justify-center px-5 py-2.5 text-sm font-semibold rounded-full backdrop-blur-xl whitespace-nowrap transition-all duration-300 relative z-10
                  bg-gradient-to-r from-white/90 via-white/95 to-white/90 dark:from-gray-900/80 dark:via-gray-800/90 dark:to-gray-900/80 
                  dark:from-gray-900/80 dark:via-gray-800/90 dark:bg-gray-900/80
                  text-[#21554E] dark:text-green-200
                  border border-gray-200 dark:border-green-400/20
                  hover:from-gray-50 hover:via-white hover:to-gray-50 dark:hover:from-gray-800/90 dark:hover:via-gray-700/90 dark:hover:to-gray-800/90
                  dark:hover:from-gray-800/90 dark:hover:via-gray-700/90 dark:hover:to-gray-800/90
                  hover:text-[#164038] dark:hover:text-green-100
                  hover:border-gray-300 dark:hover:border-green-300/30
                  shadow-sm hover:shadow-lg">
        
        <!-- Pulsing dot indicator -->
        <span class="relative flex h-2.5 w-2.5 mr-2">
          <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-[#FFC300]/75 dark:bg-green-400/75 opacity-75"></span>
          <span class="relative inline-flex rounded-full h-2.5 w-2.5 bg-gradient-to-r from-[#FFC300] to-[#FF5833] dark:from-green-400 dark:to-green-500 shadow-sm"></span>
        </span>
        
        <slot />
      </div>
      
      <!-- Subtle glow effect -->
      <div class="absolute inset-0 rounded-full bg-gradient-to-r from-[#FFC300]/20 via-transparent to-[#FF5833]/20 dark:from-green-400/20 dark:to-green-400/20 blur-sm opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
    </span>
  </div>
</a>
