---
import Badge from "../components/Badge.astro"
import LinkedInIcon from "../assets/Linkedln.astro"
import MailIcon from "../assets/Mail.astro"
import SocialPill from "../components/SocialPill.astro"
import GithubIcon from "../assets/Github.astro"
import InstagramIcon from "../assets/Instagram.astro"
---

<div class="max-w-3xl mx-auto text-center md:text-left pt-8 pb-12 md:pt-4 md:pb-4 relative z-10">
  <div class="flex flex-col items-center md:flex-row gap-3 mb-4">
    <img
      class="rounded-full shadow-xl size-24 md:size-28 border-2 border-[#FFC300] hover:border-[#FF5833] dark:border-[#51E4B8] dark:hover:border-[#21554E] transition-all duration-300"
      src="/images/merounded.png"
      alt="Foto de perfil de Rafael"
    />
    <Badge>Disponible para trabajar</Badge>
  </div>

  <h1 class="text-4xl md:text-5xl font-extrabold tracking-tight text-[#282A36] dark:text-green-100 leading-tight">
    Rafael Basanta González
  </h1>
  <p class="mt-4 text-lg md:text-xl leading-relaxed text-[#2D3748] dark:text-gray-300">
    <strong class="text-[#FF5833] dark:text-green-300 font-semibold">Desarrollador Full-Stack</strong> · Astro, React & Supabase. <br class="hidden md:block">Construyo productos web completos, de la idea al despliegue.
  </p>

  <nav class="flex flex-wrap justify-center md:justify-start gap-3 mt-6">
    <SocialPill href="mailto:rafabasanta@hotmail.com" aria-label="Email">
      <MailIcon class="size-5" />
    </SocialPill>
    <SocialPill href="https://github.com/raafa12" aria-label="GitHub">
      <GithubIcon class="size-5" />
    </SocialPill>
    <SocialPill href="https://www.linkedin.com/in/rafael-basanta-gonz%C3%A1lez-755b092a6/" aria-label="LinkedIn">
      <LinkedInIcon class="size-5" />
    </SocialPill>
    <SocialPill href="https://www.instagram.com/rafabasanta/" aria-label="Instagram">
      <InstagramIcon class="size-5" />
    </SocialPill>
  </nav>
</div>