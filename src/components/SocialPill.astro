---
// SocialPill mejorado con estilo glassmorphism espacial
---

<a
  {...Astro.props}
  target="_blank"
  rel="noopener noreferrer"
  role="link"
  class="relative inline-flex items-center justify-center gap-3 px-5 py-3 text-sm font-medium transition-all duration-300 rounded-full group max-w-fit focus:outline-none focus-visible:outline-none focus-visible:ring focus-visible:ring-amber-400/50 dark:focus-visible:ring-green-400/50 focus-visible:ring-offset-2 focus-visible:ring-offset-transparent shadow-lg hover:shadow-xl overflow-hidden
         bg-white/10 dark:bg-white/5
         backdrop-blur-md
         border border-white/20 dark:border-white/10
         text-gray-800 dark:text-gray-200
         hover:bg-white/20 dark:hover:bg-white/10
         hover:border-white/30 dark:hover:border-white/20
         hover:text-amber-700 dark:hover:text-green-300
         hover:scale-105 hover:-translate-y-0.5
         active:scale-95"
>
  <!-- Animated background gradient -->
  <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300">
    <div class="absolute inset-0 bg-gradient-to-r from-amber-400/10 dark:from-green-400/10 via-transparent to-amber-400/10 dark:to-green-400/10 animate-pulse"></div>
  </div>
  
  <!-- Subtle border glow -->
  <div class="absolute inset-0 rounded-full bg-gradient-to-r from-amber-400/20 dark:from-green-400/20 via-transparent to-amber-400/20 dark:to-green-400/20 blur-sm opacity-0 group-hover:opacity-50 transition-opacity duration-300"></div>
  
  <!-- Icon container -->
  <span class="relative z-10 transition-all duration-300 group-hover:scale-110 group-hover:rotate-3">
    <slot />
  </span>
  
  <!-- Shine effect -->
  <div class="absolute inset-0 rounded-full opacity-0 group-hover:opacity-100 transition-opacity duration-500">
    <div class="absolute top-0 left-1/4 w-1/2 h-px bg-gradient-to-r from-transparent via-white/40 to-transparent"></div>
  </div>
</a>