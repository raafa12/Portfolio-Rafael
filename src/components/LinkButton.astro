---
const { href } = Astro.props;
---

<a
    target="_blank"
    href={href}
    role="link"
    class="inline-flex bg-[#FFEAD0] text-[#920C3F] border-[#FFC86B] items-center justify-center gap-2 px-3 py-2 space-x-2 text-base transition dark:bg-gray-800 dark:border-gray-600 dark:text-white/80 focus-visible:ring-[#FFC300]/80 text-md hover:bg-[#FFD8A8] hover:border-[#FFC300] hover:text-[#C70038] dark:hover:text-green-300 group max-w-fit rounded-xl focus:outline-none focus-visible:outline-none focus-visible:ring focus-visible:ring-white focus-visible:ring-offset-2 active:bg-[#FFE8C0] dark:active:bg-green-900/50"
>
    <slot />
</a>