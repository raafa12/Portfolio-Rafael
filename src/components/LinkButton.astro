---
const { href } = Astro.props;
---

<a
    target="_blank"
    href={href}
    role="link"
    class="inline-flex bg-[#E6F7F2] text-[#21554E] border-[#51E4B8] items-center justify-center gap-2 px-3 py-2 space-x-2 text-base transition dark:bg-gray-800 dark:border-gray-600 dark:text-white/80 focus-visible:ring-[#51E4B8]/80 text-md hover:bg-[#D1F0E8] hover:border-[#21554E] hover:text-[#164038] dark:hover:text-green-300 group max-w-fit rounded-xl focus:outline-none focus-visible:outline-none focus-visible:ring focus-visible:ring-white focus-visible:ring-offset-2 active:bg-[#C1EAE0] dark:active:bg-green-900/50"
>
    <slot />
</a>