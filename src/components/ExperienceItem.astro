---
import LinkInline from "./LinkInline.astro"

interface Props {
  title: string
  titleEn?: string
  company: string
  description: string
  descriptionEn?: string
  link?: string
  date: string
  dateEn?: string
}

const { title, titleEn, company, description, descriptionEn, link, date, dateEn } = Astro.props
---

<div class="relative pl-10 border-l-2 border-[#FFC86B]/60 dark:border-green-500/30 pb-12">
  <span class="absolute -left-[13px] top-1 text-[#FF5833] dark:text-green-300 text-xl">●</span>
  <h3 class="text-2xl font-semibold text-[#282A36] dark:text-green-300">
    <span class="i18n-es">{title}</span><span class="i18n-en" hidden>{titleEn ?? title}</span>
  </h3>
  <h4 class="text-lg text-[#2D3748] dark:text-gray-100 font-medium">{company}</h4>
  <time class="text-sm text-gray-700 dark:text-gray-400 block mb-3">
    <span class="i18n-es">{date}</span><span class="i18n-en" hidden>{dateEn ?? date}</span>
  </time>
  <p class="text-[#2D3748] dark:text-gray-300 leading-relaxed">
    <span class="i18n-es">{description}</span><span class="i18n-en" hidden>{descriptionEn ?? description}</span>
  </p>

  {link && (
    <LinkInline href={link}>
      <span class="i18n-es">Saber más</span><span class="i18n-en" hidden>Learn more</span>
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M9 6l6 6-6 6" />
      </svg>
    </LinkInline>
  )}
</div>
