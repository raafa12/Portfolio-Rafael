---
import ThemeToggle from "./ThemeToggle.astro"

// Obtener la ruta actual para resaltar la sección activa
const currentPath = Astro.url.pathname;
const isHome = currentPath === '/';

const navItems = [
  {
    title: "Experiencia",
    label: "experiencia",
    url: "/#experiencia",
    id: "experiencia"
  },
  {
    title: "Proyectos",
    label: "proyectos",
    url: "/#proyectos",
    id: "proyectos"
  },
  {
    title: "About",
    label: "sobre-mi",
    url: "/#sobre-mi",
    id: "sobre-mi"
  },
]

// Función para verificar si un ítem está activo
const isActive = (item) => {
  if (!isHome) return false;
  if (typeof window === 'undefined') return false;
  
  // Si hay un hash en la URL, verificar si coincide con el ítem
  const hash = window.location.hash.substring(1);
  if (hash) {
    return hash === item.id;
  }
  
  // Si no hay hash, considerar la primera sección como activa
  return item.id === navItems[0].id;
}
---

<header class="fixed top-4 z-50 w-full flex justify-center pointer-events-none">
  <nav
    id="header-nav"
    class="flex items-center gap-2 sm:gap-4 px-3 py-2 sm:px-5 sm:py-3 text-sm sm:text-base font-medium rounded-full shadow-xl pointer-events-auto transition-all duration-300 backdrop-blur-xl border relative overflow-hidden
           bg-white/80 dark:bg-white/5
           border-gray-200 dark:border-white/10
           text-[#2D3748] dark:text-gray-200
           hover:bg-white/90 dark:hover:bg-white/8
           hover:border-gray-300 dark:hover:border-white/15
           hover:shadow-2xl hover:scale-[1.02]"
  >
    <!-- Animated background -->
    <div class="absolute inset-0 bg-gradient-to-r from-orange-400/10 via-transparent to-orange-400/10 dark:from-green-400/5 dark:to-green-400/5 opacity-0 hover:opacity-100 transition-opacity duration-500"></div>
    
    <!-- Subtle border glow -->
    <div class="absolute inset-0 rounded-full bg-gradient-to-r from-orange-400/15 via-transparent to-orange-400/15 dark:from-green-400/10 dark:to-green-400/10 blur-sm opacity-0 hover:opacity-50 transition-opacity duration-300"></div>
    
    {
      navItems.map((link) => (
        <a
          class:list={[
            'relative px-3 sm:px-4 py-1.5 sm:py-2 transition-all duration-300 rounded-full z-10',
            'group overflow-hidden',
            isActive(link) 
              ? 'text-[#B45309] dark:text-green-400' 
              : 'text-[#2D3748] hover:text-[#B45309] dark:text-gray-300 dark:hover:text-green-400',
            'hover:bg-orange-400/10 dark:hover:bg-white/10',
            'hover:scale-105 hover:-translate-y-0.5',
            'active:scale-95'
          ]}
          aria-label={link.label}
          href={link.url}
        >
          <!-- Background hover effect -->
          <div class="absolute inset-0 bg-gradient-to-r from-orange-400/10 to-amber-500/10 dark:from-green-400/10 dark:to-green-500/10 opacity-0 group-hover:opacity-100 transition-opacity duration-300 rounded-full"></div>
          
          <!-- Text content -->
          <span class="relative z-10 transition-all duration-300 group-hover:font-semibold">
            {link.title}
          </span>
          
          <!-- Active/Hover indicator -->
          <span class:list={[
            'absolute bottom-0 left-1/2 transform -translate-x-1/2 h-0.5 bg-gradient-to-r from-orange-400 to-amber-500 dark:from-green-400 dark:to-green-500 transition-all duration-300 rounded-full',
            isActive(link) ? 'w-3/4 opacity-100' : 'w-0 opacity-0 group-hover:w-1/2 group-hover:opacity-100'
          ]}></span>
          
          <!-- Shine effect on hover -->
          <div class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-500 rounded-full">
            <div class="absolute top-1 left-1/4 w-1/2 h-px bg-gradient-to-r from-transparent via-white/30 to-transparent"></div>
          </div>
        </a>
      ))
    }
    
    <div class="w-px h-5 bg-white/20 dark:bg-white/10 mx-1 sm:mx-2"></div>
    
    <div class="relative">
      <ThemeToggle class="ml-1" />
    </div>
  </nav>
</header>

<style>
  /* Subtle pulse animation for the entire nav */
  #header-nav::before {
    content: '';
    position: absolute;
    inset: -1px;
    padding: 1px;
    background: linear-gradient(45deg, 
      rgba(255, 160, 60, 0.35), 
      rgba(255, 140, 40, 0.2), 
      rgba(255, 160, 60, 0.35)
    );
    border-radius: inherit;
    mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
    mask-composite: exclude;
    opacity: 0;
    animation: borderPulse 4s ease-in-out infinite;
  }

  :global(.dark) #header-nav::before {
    background: linear-gradient(45deg, 
      rgba(81, 228, 184, 0.3), 
      rgba(120, 180, 255, 0.2), 
      rgba(81, 228, 184, 0.3)
    );
  }

  #header-nav:hover::before {
    opacity: 0.3;
  }

  @keyframes borderPulse {
    0%, 100% {
      opacity: 0;
    }
    50% {
      opacity: 0.2;
    }
  }
</style>

<script>
  document.addEventListener("astro:page-load", () => {
    const sections = document.querySelectorAll("section")
    const navItems = document.querySelectorAll("header nav a")

    const callback = (entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navItems.forEach((item) => {
            if (item.getAttribute("aria-label") == entry.target.id) {
              item.classList.add("text-amber-700", "dark:text-green-400")
              item.querySelector("span:last-of-type")?.classList.add("w-3/4", "opacity-100")
              item.querySelector("span:last-of-type")?.classList.remove("w-0", "opacity-0")
            } else {
              item.classList.remove("text-amber-700", "dark:text-green-400")
              item.querySelector("span:last-of-type")?.classList.remove("w-3/4", "opacity-100")
              item.querySelector("span:last-of-type")?.classList.add("w-0", "opacity-0")
            }
          })
        }
      })
    }

    const observer = new IntersectionObserver(callback, {
      root: null,
      rootMargin: "0px",
      threshold: 0.4,
    })

    sections.forEach((section) => observer.observe(section))

    document.onvisibilitychange = () => {
      if (document.visibilityState === "hidden") {
        observer.disconnect()
      } else {
        sections.forEach((section) => observer.observe(section))
      }
    }
  })
</script>

